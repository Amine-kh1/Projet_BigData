# Official community registries may reject anonymous pulls. Build the pinned
# upstream source tags instead; the resulting binaries remain MinIO and mc.
FROM golang:1.24.2-bookworm AS build
ARG MINIO_TAG=RELEASE.2025-04-22T22-12-26Z
ARG MC_TAG=RELEASE.2025-04-16T18-13-26Z
ENV CGO_ENABLED=0
RUN mkdir -p /src/minio /src/mc /out \
    && curl --fail --location --retry 3 \
       "https://codeload.github.com/minio/minio/tar.gz/refs/tags/${MINIO_TAG}" --output /tmp/minio.tar.gz \
    && tar -xzf /tmp/minio.tar.gz --strip-components=1 -C /src/minio \
    && curl --fail --location --retry 3 \
       "https://codeload.github.com/minio/mc/tar.gz/refs/tags/${MC_TAG}" --output /tmp/mc.tar.gz \
    && tar -xzf /tmp/mc.tar.gz --strip-components=1 -C /src/mc
WORKDIR /src/minio
RUN go build -trimpath -ldflags "-s -w" -o /out/minio .
WORKDIR /src/mc
RUN go build -trimpath -ldflags "-s -w" -o /out/mc .

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/mc /usr/local/bin/mc
ENV MC_CONFIG_DIR=/tmp/.mc
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
